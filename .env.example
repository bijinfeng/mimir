# ── 数据库 ──
# 开发时容器把 5432 映射到宿主机 5544（避开常见的 5432/5433）
DB_USER=mimir
DB_PASSWORD=mimir
DB_NAME=mimir
DB_PORT=5544
DATABASE_URL=postgres://mimir:mimir@127.0.0.1:5544/mimir

# ── 服务 ──
PORT=3000
SERVER_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# 必填。生成方式：openssl rand -base64 32
# 生产环境若保持默认值，服务端会拒绝启动。
AUTH_SECRET=dev-only-insecure-secret-change-me

# ── 运行时目录（一律相对仓库根目录解析）──
DATA_DIR=./data
VAULT_DIR=./data/vault
RAW_DIR=./data/raw

# ── 生产部署（docker compose --profile prod）──
APP_PORT=3000
