# ── 数据库 ──
# 开发时容器把 5432 映射到宿主机 5544（避开常见的 5432/5433）
DB_USER=mimir
DB_PASSWORD=mimir
DB_NAME=mimir
DB_PORT=5544
DATABASE_URL=postgres://mimir:mimir@127.0.0.1:5544/mimir

# ── 服务 ──
PORT=3000
SERVER_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# 必填。生成方式：openssl rand -base64 32
# 生产环境若保持默认值，服务端会拒绝启动。
AUTH_SECRET=dev-only-insecure-secret-change-me

# ── 所有者账号（推荐设置，生产尤其）──
# 设置后服务端启动时会按这两个值准备好账号，**跳过首次注册**。
# 不设置则走「第一个注册的人成为唯一用户」。
#
# 为什么推荐设置：
#   1. 不设的话，部署完到你注册之间有一个时间窗——服务若已暴露公网，
#      谁先访问谁就成为那个唯一用户，拿到的是你整个知识库
#   2. 清库重建（换分支、改 schema）不会丢账号，重启即恢复
#   3. **改这里再重启就是「忘记密码」的找回方式**（库里的账号邮箱一致时
#      会自动同步密码）
#
# 两个都要设，只设一个会启动报错。密码至少 8 位。
# OWNER_EMAIL=me@example.com
# OWNER_PASSWORD=change-me-please

# ── 可选：模型（不配也能用）──
# 不配时问答走「只检索」路径，把命中的原文原样列出来，并且不花钱。
# 密钥只存服务端，绝不下发浏览器。任何 OpenAI 兼容端点都行（DeepSeek / 通义 / 智谱 / Kimi）。
# MODEL_API_KEY=sk-...
# MODEL_BASE_URL=https://api.deepseek.com/v1
# MODEL_PROVIDER_NAME=deepseek
# MODEL_CHAT_MODEL=deepseek-chat
# MODEL_REASONING_MODEL=deepseek-reasoner

# ── 可选：GitHub 抓取 ──
# 配了可以把 API 限额从 60 次/小时提到 5000 次
# GITHUB_TOKEN=ghp_...

# 注：开发时代理目标（VITE_API_TARGET）**不在这里配**——
# Vite 只读启动进程的环境变量，写了也不生效。
# 需要时用：VITE_API_TARGET=http://localhost:3100 pnpm dev

# ── 运行时目录（一律相对仓库根目录解析）──
DATA_DIR=./data
VAULT_DIR=./data/vault
RAW_DIR=./data/raw

# ── 生产部署（docker compose --profile prod）──
APP_PORT=3000
