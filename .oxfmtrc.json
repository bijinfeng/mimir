{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    // Installed Impeccable release scripts are third-party artifacts, not project source.
    ".agents/skills/impeccable/scripts/**",
    ".claude/skills/impeccable/scripts/**",
    ".github/skills/impeccable/scripts/**",
    // Local package-manager cache contains dependency metadata, not maintained source.
    ".pnpm-store/**",
    "**/routeTree.gen.ts",
    "**/drizzle/**",
    "output/**",
    "pnpm-lock.yaml",
    "**/*.md",
    ".agents/**",
    ".trellis/.template-hashes.json",
    ".trellis/tasks/**",
    // Raw component DOM captured as visual evidence; formatting would rewrite the archived bytes.
    "docs/visual-comparisons/2026-10-20-desktop-client/{before,after}/**/*.html",
    "docs/visual-comparisons/2026-10-20-settings-secondary/{before,after}/**/*.html"
  ]
}
