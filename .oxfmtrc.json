{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    "**/drizzle/**",
    "output/**",
    "pnpm-lock.yaml",
    "**/*.md",
    ".agents/**"
  ]
}
