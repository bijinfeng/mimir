{
  // oxlint 的配置文件支持注释（内部按 JSONC 解析）。
  // 每条被关闭的规则都必须写明理由，否则下次有人会以为是漏配。
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "rules": {
    // 用 typescript 版本，它认得类型位置与 _ 前缀的约定
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
    ],

    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    // React 17+ 的自动 JSX 运行时不需要 React 在作用域内，这条是历史遗留规则
    "react/react-in-jsx-scope": "off",

    // 这条建议手写 useMemo 包裹 context value，但本项目开了 React Compiler，
    // 它**已经**在编译期给 context value 插入记忆化（见 .trellis/spec/project/decisions.md D-009
    // 与 .trellis/spec/renderer/frontend/conventions.md：不要手写 useMemo / useCallback / memo）。
    // 手写一份会让「哪些记忆化是编译器做的」变得含混，而且编译器不会因为
    // 存在手写记忆化就停止工作——两套机制叠在一起只会让人误判优化来源。
    "react/jsx-no-constructed-context-values": "off",

    // 服务端有几处刻意的顺序写入（重建索引、逐条 upsert）。
    // 改成并行会引入并发控制，对个人规模的数据不值得；而且顺序执行便于定位
    // 「卡在哪一条」——重建索引失败时这一点很重要。
    "no-await-in-loop": "off",

    // Tiptap 的包同时提供 default 和 named 导出，这条规则会误报。
    // 我们统一用 named 导入（与官方文档一致）。
    "import/no-named-as-default": "off",
    // 样式是副作用导入，本来就不需要绑定名字
    "import/no-unassigned-import": "off",

    // 开发环境的热重载单例用 __ 前缀标记（见 db/client.ts）
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__mimirSql",
          "__mimirSqlite",
          "__mimirPagination",
          "__mimirPagError",
          // 浏览器 <-> runtime 的 base path 协议（runtime/static.ts 注入，前端只读）
          "__MIMIR_BASE_PATH__"
        ]
      }
    ],

    "unicorn/prefer-node-protocol": "error",
    "no-console": "off",

    // 这条规则本意是拦「用同一个引用值填满数组」，但 canvas 的
    // `ctx.fill(path, 'evenodd')` 形状与它撞了——它把 ctx.fill 认成
    // Array.prototype.fill。图标脚本（apps/desktop/scripts/make-icons.ts）
    // 正是这么画的，而那是标准用法。代码里的行内豁免对这条规则不生效
    // （next-line / disable 都试过），所以在这里关
    "unicorn/no-array-fill-with-reference-type": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    // Installed Impeccable release scripts are third-party artifacts, not project source.
    ".agents/skills/impeccable/scripts/**",
    ".claude/skills/impeccable/scripts/**",
    ".github/skills/impeccable/scripts/**",
    // Local package-manager cache contains dependency metadata, not maintained source.
    ".pnpm-store/**",
    // Product Design mobile template runtime: protected upstream files, verified by mobile-runtime.lock.json.
    ".trellis/tasks/**/10-17-wechat-miniapp-research/prototype/src/mobile/**",
    // Match the same task-owned third-party paths before and after task archive.
    // Verbatim downloaded SDK/UI evidence is third-party reference source, not product code.
    ".trellis/tasks/**/10-18-interaction-chat/prototype/v3/vendor/**",
    ".trellis/tasks/**/10-18-interaction-chat/prototype/v4/vendor/**",
    ".trellis/tasks/**/10-18-interaction-chat/research/vendor-full-thread/**",
    ".trellis/tasks/**/10-18-interaction-chat/research/tanstack-latest-evidence/**",
    ".trellis/tasks/**/10-18-interaction-chat/research/tanstack-v5-evidence/**",
    "**/routeTree.gen.ts",
    "**/drizzle/**",
    "output/**",
    // pdf.js 的运行时资产（D-056）。它们是第三方**构建产物**：cmaps 是
    // Adobe 的字符集映射表、standard_fonts 是字体、wasm 目录里还有 pdf.js
    // 自带的 minified JS（quickjs-eval.js）。它们不是一个字的源代码，
    // 而是「按原始文件名被运行时取用」的数据文件——所以放 public/ 让打包器
    // 原样复制，也不该被 lint 读一遍
    "apps/web/public/pdfjs/**"
  ]
}
