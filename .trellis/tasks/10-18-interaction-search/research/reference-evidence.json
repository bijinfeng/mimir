  "evidence": [
    {
      "source": "https://weknora.weixin.qq.com/",
      "retained": "weknora-official.html",
      "quote": "结合语义与关键词检索查找相关资料，回答附带来源引用，可打开原文核对。",
      "application": "维持检索命中到原文核查路径，不能因条目美化丢掉chunk定位；官网不证明登录后的交互细节。"
    },
    {
      "source": "https://raw.githubusercontent.com/Tencent/WeKnora/3e22822c1d2397be730c458c7539d0eb8c113a24/frontend/src/components/GlobalCommandPalette/useSearch.ts",
      "retained": "weknora-useSearch.ts.source.txt",
      "lines": "57-80,233-281,332-349",
      "fact": "默认350ms debounce；单调requestSeq丢弃旧响应；空词清结果；检索知识chunk和消息并按知识文件聚合。",
      "application": "借鉴输入确认与请求归属意识；Mimir已有queryKey隔离，不能声称同样存在迟到覆盖bug；不要移植知识库锁定/消息搜索/Agent搜索。"
    },
    {
      "source": "https://raw.githubusercontent.com/Tencent/WeKnora/3e22822c1d2397be730c458c7539d0eb8c113a24/frontend/src/components/GlobalCommandPalette/ResultItem.vue",
      "retained": "weknora-ResultItem.vue.source.txt",
      "lines": "1-35,69-114",
      "fact": "button行、title/subtitle、主动作/hover独立事件；selected使用中性secondarycontainer；flex min-width0。",
      "application": "可采用安静中性选中及可读标题片段，与已获批语雀token相容；不照搬相似度百分比、向量徽标、命令数字快捷键。"
    },
    {
      "source": "https://raw.githubusercontent.com/Tencent/WeKnora/3e22822c1d2397be730c458c7539d0eb8c113a24/frontend/src/components/GlobalCommandPalette/useStartChat.ts",
      "retained": "weknora-useStartChat.ts.source.txt",
      "lines": "20-37",
      "fact": "startChat把query设为prefill并router到creatChat，同时可绑定KB/文件。",
      "application": "Mimir同样是显式AI草稿交接而非自动发送；沿用scope及既有AskDraft，不新增KB锁定和文件附件能力。"
    },
    {
      "source": "https://raw.githubusercontent.com/Tencent/WeKnora/3e22822c1d2397be730c458c7539d0eb8c113a24/frontend/src/components/GlobalCommandPalette/useSearch.ts",
      "retained": "weknora-useSearch.ts.source.txt",
      "lines": "260-277",
      "fact": "搜索失败catch记录console并返回空集合。",
      "application": "不照搬吞错；Mimir本轮应明确失败和重试，不把网络失败画成无匹配。"
    }
  ],
  "designAuthority": "用户已认可语雀适配视觉为主；Obsidian仅布局连续性；WeKnora按KB/Agent领域研究，非Office编辑工具条规范。",
  "limitations": [
    "仅HTTP和固定源码核查，未登录运行WeKnora工作台",
