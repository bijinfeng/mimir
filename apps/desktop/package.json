{
  "name": "@mimir/desktop",
  "version": "0.1.4",
  "private": true,
  "description": "mimir 桌面端：Electron 载体 + 进程内私有宿主（D-046）；渲染进程由 electron-vite 构建（D-103）",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm routes:generate && electron-vite build",
    "build:watch": "node scripts/watch-build.mjs",
    "start": "electron .",
    "package": "node scripts/package.mjs",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "test": "vitest run",
    "icons": "tsx scripts/make-icons.ts",
    "routes:generate": "node ../../packages/renderer/generate-routes.mjs src/renderer/routeTree.gen.ts src/renderer/routes /client"
  },
  "dependencies": {
    "@mimir/renderer": "workspace:*",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@mimir/server": "workspace:*",
    "@mimir/shared": "workspace:*",
    "@napi-rs/canvas": "1.0.9",
    "@types/node": "catalog:",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "antd": "catalog:",
    "antd-style": "catalog:",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.7",
    "lucide-react": "^1.48.0",
    "oxc-transform-react": "0.145.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
