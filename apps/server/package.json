    "@tanstack/ai": "0.55.0",
    "@tanstack/ai-openai": "0.22.8",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.8",
    "linkedom": "^0.18.13",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "turndown": "^7.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "catalog:",
