{
  "name": "@mimir/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.local.config.ts && vitest run --config vitest.fnos.config.ts && node --test scripts/sqlite-backup.node-test.mjs",
    "db:generate:pg": "drizzle-kit generate",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle-sqlite.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reindex": "tsx src/db/migrate.ts --reindex",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@hono/node-server": "^2.1.1",
    "@mimir/core": "workspace:*",
    "@mimir/plugin-capturer": "workspace:*",
    "@mimir/plugin-leg": "workspace:*",
    "@mimir/plugin-parser": "workspace:*",
    "@mimir/plugin-provider": "workspace:*",
    "@mimir/plugin-storage": "workspace:*",
    "@mimir/shared": "workspace:*",
    "@mimir/tokenizer": "workspace:*",
    "@mozilla/readability": "0.6.0",
    "@node-rs/jieba": "^2.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/ai": "0.55.0",
    "@tanstack/ai-openai": "0.22.8",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "harfbuzzjs": "0.10.3",
    "hono": "^4.13.8",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "nanoid": "^6.0.1",
    "pdf-lib": "catalog:",
    "pdfjs-dist": "catalog:",
    "postgres": "^3.4.9",
    "sqlite-vec": "0.1.9",
    "turndown": "^7.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ag-ui/client": "0.0.59",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
