  "narrative": {
    "northStar": "安静的知识工作台",
    "overview": "mimir 让笔记、资料与可核对来源的回答占据视觉中心。白灰工作面、单一左侧导航、清楚的文字层级与少量绿色操作，形成安静、清晰、紧凑的工作环境。阅读画布保留宽松行距，操作区保持便于扫读的密度。\n\n本次已批准的语雀方向取代此前冷灰蓝视觉系统。语雀公开知识库与阅读页有实测证据；私人工作台、实际编辑器、深色及窄屏采用 Mimir 适配设计，不宣称精确复刻。正式令牌来自共享 renderer 主题，优先于静态稿及 Stitch 自动生成的默认设计系统。Web 与 Desktop 共用产品身份和工作区主题。",
    "keyCharacteristics": [
      "中性表面与细分隔线建立连续工作区，正文拥有更宽松的阅读节奏。",
      "当前导航用灰底、加粗和语义标识；绿色用于主操作、链接与真实语义状态。",
      "浅深外观分别校准，共享字体、控件形状、响应式事实与现有操作行为。"
    ],
    "rules": [
      {
        "name": "The Separate Selection Rule",
        "body": "导航选中使用专用中性角色；用途选择与编辑器按下使用品牌语义角色。不得把全局 `colorPrimaryBg` 改灰来实现导航外观。",
        "section": "colors"
      },
      {
        "name": "The Content Color Rule",
        "body": "Office 原件纸张、正文、调色板与文档中的用户颜色保留内容语义，深色外观不全局反转内容。界面品牌迁移只改变工作区和控件角色。",
        "section": "colors"
      },
      {
        "name": "The Reading Rhythm Rule",
        "body": "UI 保持紧凑，连续阅读使用独立 reading 角色及 `READING_LINE_HEIGHT`；不能通过放大全局 body 改变工具条与表单密度，也不能为压缩列表而降低正文可读性。",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "普通列表与内容卡片不叠加重阴影；阴影只说明元素确实浮在其他内容之上。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 让 renderer 真实令牌统领 Web / Desktop、Chat 与 Office，并同步维护本文和 `.impeccable/design.json`。",
      "Do 用中性导航与绿色语义角色分别表达位置和操作状态。",
      "Do 保留搜索、收集、上传、新建、直接编辑、保存、AI 范围与引用等真实行为。",
      "Do 检查浅深外观、关键断点、容器折行、键盘焦点和窄屏关闭 / 返回路径。"
    ],
    "donts": [
      "Don't 重新引入旧冷灰蓝品牌色或直接套用生成稿的自动色阶。",
      "Don't 为外观覆盖用户内容颜色、移走主题桥祖先或新增独立主题 provider。",
      "Don't 用缩小正文、隐藏命令或固定宽度撑破页面来换取紧凑。",
      "Don't 把来源参考和静态图当作新增团队、发布、仪表盘或读写模式切换功能的依据。"
    ]
  }
}
