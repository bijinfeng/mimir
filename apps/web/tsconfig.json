{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // vite / vitest 的配置文件要显式带扩展名互相引用（alias.ts）：
    // 它们的加载器不走 TS 的解析规则，不带扩展名会打警告。
    // 只在 noEmit 下合法，本包正好是 noEmit。
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "alias.ts"]
}
