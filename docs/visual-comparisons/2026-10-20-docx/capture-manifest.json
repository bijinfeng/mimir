  "pairs": [
    {
      "key": "style",
      "title": "样式定义与应用",
      "caption": "1100×640编辑区，1280×720视口。目标有可见名称，长表单独立滚动，动作固定；未改定义时应用选区为主操作。",
      "dimensions": [1280, 720]
    },
    {
      "key": "chart",
      "title": "图表 · 深色窄栏",
      "caption": "690×640编辑区，1280×720视口。保留分类和系列字段，提交从滚动末尾移至固定动作区。",
      "dimensions": [1280, 720]
    },
    {
      "key": "phone-chart",
      "title": "手机宽度 · 面板入口",
      "caption": "390×640真实视口。打开属性前收起原工具菜单，面板标题与提交动作可见。",
      "dimensions": [390, 640]
    },
    {
      "key": "textbox",
      "title": "文本框属性",
      "caption": "690×640编辑区，1280×720视口。尺寸、位置、环绕、文字和颜色全部保留，独立滚动与固定插入动作。",
      "dimensions": [1280, 720]
    },
    {
      "key": "page",
      "title": "页面与节",
      "caption": "690×640编辑区，1280×720视口。页面设置固定应用；分节符原有独立操作继续可达。",
      "dimensions": [1280, 720]
    },
    {
      "key": "watermark",
      "title": "文字与图片水印",
      "caption": "690×640编辑区，1280×720视口。保留文字、图片和移除三个入口，动作分级且可换行。",
      "dimensions": [1280, 720]
    },
    {
      "key": "notes",
      "title": "原生脚注与尾注管理",
      "caption": "690×640编辑区，1280×720视口。原件包含20条脚注；面板入口收起父菜单，修改与删除保留。",
      "dimensions": [1280, 720]
    },
    {
      "key": "design",
      "title": "主题设计草稿",
      "caption": "690×640编辑区，1280×720视口。同一Facet草稿，应用设计明确主操作。作者页面及原件颜色规则保持。",
      "dimensions": [1280, 720]
    },
    {
      "key": "find",
      "title": "查找与替换",
      "caption": "690×640编辑区，1280×720视口。同一“段”查询与2个匹配；Escape回焦由真实交互记录证明，截图记录栏布局保持。",
      "dimensions": [1280, 720]
    }
  ],
  "supplements": [
    {
      "key": "chart-inserted",
      "title": "真实插入图表",
      "caption": "真实点击主操作后画布出现图表，保存与撤销启用。"
    },
    {
      "key": "notes-applied",
      "title": "原生脚注替换",
      "caption": "通过实际查找/替换和应用动作修改原生脚注，未简化原件写入路径。"
    },
    {
      "key": "privacy-stale",
      "title": "个人信息 · 过期设置",
      "caption": "正文变化使设置过期，可见“重新读取设置”按钮保留恢复路径。"
    },
    {
      "key": "short-textbox",
      "title": "短高文本框",
      "caption": "390×360真实视口。面板内部滚动，固定插入动作保持可达。"
    },
    {
      "key": "view-navigation",
      "title": "文档导航与视图",
      "caption": "现有导航、Web/打印/阅读与唯一正文编辑器的回归记录。"
    }
  ],
