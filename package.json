{
  "name": "mimir",
  "version": "0.1.0",
  "private": true,
  "description": "个人知识库：Markdown 笔记 + 资料收集 + 带引用的 AI 问答",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/desktop-dev-process.test.mjs scripts/fnos-package.test.mjs apps/desktop/scripts/release-artifacts.test.mjs apps/desktop/scripts/update-smoke.test.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm lint:styles && pnpm format:check && pnpm -r typecheck && pnpm test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate:pg": "pnpm --filter @mimir/server db:generate:pg",
    "db:generate:sqlite": "pnpm --filter @mimir/server db:generate:sqlite",
    "db:migrate": "pnpm --filter @mimir/server db:migrate",
    "db:reindex": "pnpm --filter @mimir/server db:reindex",
    "db:studio": "pnpm --filter @mimir/server db:studio",
    "docker:prod": "docker compose --profile prod up -d --build",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:start": "pnpm --filter @mimir/server build && pnpm --filter @mimir/desktop build && pnpm --filter @mimir/desktop start",
    "desktop:build": "pnpm --filter @mimir/server build && pnpm --filter @mimir/desktop build && node apps/desktop/scripts/deploy-server.mjs && pnpm --filter @mimir/desktop package",
    "fnos:build": "node scripts/build-fnos.mjs",
    "lint:styles": "node scripts/check-style-backticks.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "yaml": "2.8.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2"
}
