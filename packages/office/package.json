    "@codemirror/view": "catalog:",
    "@embedpdf/pdfium": "2.15.1",
    "@google/model-viewer": "4.4.0",
    "@lezer/highlight": "catalog:",
    "@mimir/shared": "workspace:*",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-task-list": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "acorn": "8.15.0",
    "bidi-js": "catalog:",
    "cfb": "1.2.2",
    "fast-xml-parser": "^5.3.4",
