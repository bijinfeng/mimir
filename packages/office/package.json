{
  "name": "@mimir/office",
  "version": "0.1.0",
  "private": true,
  "description": "Office 文档的浏览器内预览与编辑。引擎与编辑器 vendored 自 GenOffice（Apache-2.0），见 vendor/UPSTREAM.json",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./editor.css": "./src/generated/editor.css",
    "./editors.css": "./src/editors/editors.css",
    "./shell.css": "./src/shell/shell.css",
    "./note-links": "./src/editors/note-links.ts",
    "./test-dom": "./src/shell/antd-test-dom.ts",
    "./vendor/extensions": "./vendor/apps/docs/src/renderer/editor/extensions.ts",
    "./vendor/fonts.css": "./vendor/apps/docs/src/renderer/fonts/fonts.css",
    "./vendor/styles.css": "./vendor/apps/docs/src/renderer/styles.css",
    "./vendor/types": "./vendor/packages/docx-engine/src/types.ts",
    "./encryption-envelope": "./src/docx-encryption-envelope.ts"
  },
  "scripts": {
    "sync": "node scripts/sync-upstream.mjs",
    "verify": "node scripts/verify-vendor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
